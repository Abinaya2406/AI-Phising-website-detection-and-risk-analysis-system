# PhishGuard AI Backend Configuration

# Flask Environment
FLASK_ENV=development
FLASK_APP=run.py
SECRET_KEY=change-this-to-a-secure-random-key-in-production

# Server Port
PORT=8000

# MongoDB Connection String
MONGO_URI=mongodb://localhost:27017/phishguard_db
MONGO_DB_NAME=phishguard_db

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Upload Configuration
MAX_CONTENT_LENGTH=10485760
UPLOAD_FOLDER=uploads

# Network & Security Timeout
REQUEST_TIMEOUT_SECONDS=10
ALLOWED_EXTENSIONS=png,jpg,jpeg,webp

# Feature & Engine Flags
ENABLE_DEMO_DATA_FALLBACK=true

# Feature 4: Bilingual AI Security Assistant (Tamil & English)
# Optional: Provide Gemini or OpenAI API key. If unset, PhishGuard AI uses the built-in rule-based evidence engine.
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# AI_PROVIDER=auto  # Options: auto, gemini, openai, fallback
# AI_MODEL=gemini-1.5-flash
# AI_TIMEOUT_SECONDS=8

